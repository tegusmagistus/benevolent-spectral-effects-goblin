pro-quick{padding:7px 9px 3px;background:#101326;border-bottom:1px solid #49405d;min-width:0;overflow:hidden}.pro-quick-head{display:flex;align-items:center;justify-content:space-between;height:17px;font:8px monospace;letter-spacing:.16em;color:#bab1d0;margin-bottom:3px}#proScope{font:8px monospace;color:#b5a7ca;background:transparent;border:0;padding:4px;cursor:pointer}.pro-core-scroll{display:flex;gap:6px;overflow-x:auto;overflow-y:hidden;scrollbar-width:none;padding:0 0 3px;touch-action:pan-x}.pro-core-scroll::-webkit-scrollbar{display:none}.pro-core-scroll button{display:flex;align-items:center;justify-content:center;gap:5px;flex:1 0 67px;min-height:34px;border-radius:6px;border:1px solid #55506f;background:linear-gradient(130deg,#292b44,#15192f);color:#d9d4e9;font:10px system-ui;box-shadow:inset 0 1px #c5b2e233;position:relative}.pro-core-scroll button span{color:#d5b6f5;font-size:13px}.pro-core-scroll button[aria-pressed=true]{border-color:#c6a4ea;background:linear-gradient(120deg,#58456f,#252241);color:#fff}.pro-core-scroll button.in-chain:after{content:'';position:absolute;bottom:2px;width:15px;height:2px;background:#b69bd7;border-radius:2px}.pro-quick-tune{background:#0d1222;padding:4px 11px 5px;min-height:0;border-bottom:1px solid #534560}.pro-active-line{height:22px;display:flex;align-items:center;justify-content:space-between;gap:6px}#proActiveName{font:500 9px system-ui;letter-spacing:.06em;color:#e9d8fa;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}#proBypass{font:9px system-ui;background:#161c30;border:1px solid #635775;color:#bcadca;border-radius:4px;padding:3px 7px;min-width:56px;min-height:22px}#proBypass[aria-pressed=true]{border-color:#cfac80;color:#f4c99d}.pro-strength-row{display:flex;align-items:center;gap:8px;font:9px system-ui;color:#b4b3ca;height:27px}#proStrength{flex:1;min-width:35px;height:27px;accent-color:#cab0e8;touch-action:pan-y}#proStrengthNumber{width:41px;height:24px;text-align:right;border:1px solid #5d5472;border-radius:4px;background:#0a0f1d;color:#e6d3ff;font:11px monospace}body.pro-console .timeline{grid-column:2!important;grid-row:2!important;min-height:0!important;max-height:100%;overflow:auto!important;background:#0d1120!important;border-width:5px!important;border-radius:10px!important;box-shadow:none!important;padding:2px!important}body.pro-console .timelinehead{padding:4px 9px!important;gap:8px;align-items:center}body.pro-console .timelinehead .eyebrow{display:none}body.pro-console .timelinehead h3{font:14px Georgia,serif!important;margin:0!important}body.pro-console .timelinehead .little{padding:5px 7px!important;font-size:8px!important;min-height:26px}body.pro-console .timeline-ruler{margin:3px 10px 3px 135px!important;height:14px;font-size:8px}body.pro-console .layer-lanes{padding:0 8px!important;max-height:none!important;overflow:visible}body.pro-console .layer-lane{grid-template-columns:118px minmax(0,1fr)!important;height:28px!important;gap:7px!important}body.pro-console .lane-title{font-size:9px!important;min-width:0!important;background:#151b30!important;border-color:#4e4764!important}body.pro-console .lane-track{border-color:#635673!important;background:#10152a!important}body.pro-console .lane-fill{opacity:.58;background:linear-gradient(95deg,#ad91c5,#84afcb 40%,#a689bd 75%,#c0a9cc)!important}body.pro-console .timelinehint{display:none!important}body.pro-console .inspector-content{min-height:0!important;max-height:none!important;overflow:auto!important;padding:10px!important;flex:1;scrollbar-color:#776b97 #101424}body.pro-console .inspector-foot{padding:8px!important;min-height:0;flex-shrink:0;background:#121726!important;border-color:#4e4167!important;font-size:9px}body.pro-console .inspector-foot strong{font:8px monospace!important}body.pro-console .inspector-foot small{font:8px/1.4 system-ui!important;color:#9da4bd!important}body.pro-console .detailcard{padding:12px!important;margin:10px 0!important;background:#14192c!important;border-color:#4b4561!important;box-shadow:none!important}body.pro-console .detailcard h3{font:21px Georgia,serif!important;color:#e8ddf6!important;margin:6px 0 8px!important}body.pro-console .detailcard>p,body.pro-console .hint{font:10px/1.5 system-ui!important;color:#a7aac0!important}body.pro-console .fx-fine-tune,body.pro-console .ritual-mini{background:#0d1426!important;border-color:#61526d!important;padding:8px!important}body.pro-console .controlrow{font:10px system-ui!important;margin:9px 0 2px!important}body.pro-console .rangefull{height:25px;accent-color:#c8b0e5!important;touch-action:pan-y}.pro-value-input{width:57px;height:25px;text-align:right;font:10px monospace;color:#dac9f1;border:1px solid #605674;border-radius:4px;background:#0b1020;padding:2px 4px}body.pro-console .stack-card{min-height:35px;gap:5px;background:#161d30!important;border-color:#4e4663!important;padding:6px!important}body.pro-console .stack-card.active{border-color:#ae8fc9!important;background:#29233e!important}body.pro-console .stack-name{font-size:9px!important;color:#dcd1ef!important}body.pro-console .mini-controls button{min-width:20px;min-height:24px;padding:1px;font-size:11px}body.pro-console .scope-switch button{min-height:32px;font:8px system-ui!important;background:#161a2b!important;border-color:#504361!important}body.pro-console .scope-switch button.active{background:#3b2e50!important;color:#efe1fa!important}body.pro-console .scope-hint{font:9px/1.4 system-ui;color:#a6a2bd}body.pro-console .footer-note{height:26px;min-height:0!important;padding:5px 8px!important;background:#0d0d1c!important;display:flex!important;align-items:center;justify-content:center;border-color:#68517688!important;font-size:0!important}body.pro-console .footer-note>span{font-size:0!important;line-height:0}body.pro-console .footer-note small:not(.secret-credit){display:none!important}body.pro-console .secret-credit{margin:0!important;font:7px/1.4 monospace!important;letter-spacing:.27em!important;color:#a99abd!important;text-align:center;text-shadow:none!important}body.pro-console .footer-note #sparklesToggle{display:none!important}body.pro-console .sparkle-layer{z-index:3!important;opacity:.65;pointer-events:none!important}body.pro-console .console-spark{animation:none!important;opacity:.75;transform:scale(.65)}body.pro-console #toast{position:fixed;bottom:38px;left:50%;transform:translateX(-50%);padding:8px 12px;max-width:min(450px,90vw);font:11px/1.45 system-ui!important;background:#13192e!important;border-color:#9b81bc!important;z-index:1000;pointer-events:none}.pro-tools{display:none;min-height:0;overflow:auto;background:#101526;border:1px solid #8f6db0;border-radius:12px;color:#d8d4e8;padding:14px;scrollbar-width:thin;scrollbar-color:#776b97 #101424}body.pro-tools-open .pro-tools{display:block;position:absolute;top:8px;right:8px;bottom:8px;width:min(400px,85%);z-index:20;box-shadow:0 15px 60px #000d}.pro-panel-title span{font:8px monospace;color:#bcb0cf;letter-spacing:.18em}.pro-panel-title h2{font:26px Georgia,serif;color:#e9dcf4;margin:7px 0 14px}.pro-tools-close{float:right;border:1px solid #665275;background:#171b2f;color:#e6d5fb;border-radius:6px;width:32px;height:32px}.pro-secondary{border-top:1px solid #4c415c;margin-top:14px;padding-top:9px}.pro-secondary summary{font:12px system-ui;cursor:pointer;padding:6px 0;color:#e3d4f5}.pro-secondary summary span{display:block;color:#979db6;font:9px system-ui;margin:4px 0 7px}body.pro-console .pro-tools .import-grid{display:grid!important;grid-template-columns:1fr 1fr!important;grid-template-rows:70px 70px!important;padding:6px 0!important;gap:6px!important}body.pro-console .pro-tools .import-box,body.pro-console .pro-tools .import-box:first-child,body.pro-console .pro-tools .import-box:last-child{display:flex!important;grid-column:auto!important;grid-row:auto!important;border-image:none!important;border:1px solid #67617c!important;background:linear-gradient(140deg,#272a43,#13172a)!important;min-height:0!important;padding:10px!important;align-items:flex-start!important;justify-content:center!important;gap:3px!important;box-shadow:none!important;border-radius:7px!important}body.pro-console .pro-tools .import-glyph,body.pro-console .pro-tools .import-box:after{display:none!important}body.pro-console .pro-tools .import-box strong{font:11px system-ui!important;letter-spacing:.07em!important}body.pro-console .pro-tools .import-box small{font:8px system-ui!important;color:#a6a3bd!important}body.pro-console .pro-tools .project-meta{margin:0!important;padding:0!important;display:block;min-width:0!important}body.pro-console .pro-tools .project-meta input{width:100%!important;max-width:100%;border:1px solid #655976!important;padding:10px!important;font-size:12px!important;background:#0b1021!important;border-radius:5px}body.pro-console .pro-tools .stage-options{display:flex!important;flex-wrap:wrap;gap:6px!important;min-width:0!important;padding:7px 0}body.pro-console .pro-tools .stage-options select{max-width:100%;font-size:10px!important;min-height:34px;background:#151b30!important}.pro-project-actions{display:flex;flex-wrap:wrap;gap:7px;padding:10px 0}.pro-local-note{font:10px/1.6 system-ui;color:#9ca4bd}.pro-capability-note{font:10px/1.4 system-ui;color:#dbbc99;border-bottom:1px solid #614e3b;padding:8px 10px;background:#241c20}.pro-tabs{display:none}body.pro-console [hidden]{display:none!important}body.pro-console button:focus-visible,body.pro-console input:focus-visible,body.pro-console summary:focus-visible{outline:2px solid #e0c7ff!important;outline-offset:2px!important}@media(min-width:1700px){body.pro-console .workspace{grid-template-columns:260px minmax(0,1fr) 305px!important}body.pro-console .logo-sub{font-size:46px!important}}@media(max-width:1150px) and (min-width:1001px){body.pro-console .workspace{grid-template-columns:195px minmax(0,1fr) 245px!important;gap:6px!important;padding:6px!important}body.pro-console #app{grid-template-rows:120px 44px 22px minmax(0,1fr) 22px}body.pro-console .brandmark{width:82px!important;min-width:82px!important;height:90px!important}body.pro-console .guardian-portrait{height:108px!important}body.pro-console .guardian-portrait img{height:124px!important}body.pro-console .core-fx button{flex-basis:65px}}@media(max-width:1000px){body.pro-console{padding:env(safe-area-inset-top,0px) env(safe-area-inset-right,0px) env(safe-area-inset-bottom,0px) env(safe-area-inset-left,0px)!important}body.pro-console #app{height:100vh;height:calc(100dvh - env(safe-area-inset-top,0px) - env(safe-area-inset-bottom,0px));min-height:0!important;border-width:4px!important;border-radius:0;grid-template-rows:54px 44px minmax(0,1fr) 16px!important;padding:0!important}body.pro-console .topbar{padding:3px 6px 8px!important}body.pro-console .topbar:after{height:8px!important}body.pro-console .brand{gap:6px!important}body.pro-console .brandmark{width:35px!important;min-width:35px!important;height:39px!important}body.pro-console .logo-main{font-size:23px!important;letter-spacing:-.0