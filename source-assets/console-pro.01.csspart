 body.pro-console{--bg:#070811;--panel:#10121f;--panel2:#171a2b;--text:#f0eef9;--sub:#c9c8db;--muted:#969bb9;--accent:#decbff;--edge:#56546f;--edge2:#78718f;--glow:#d5bcff;background:#050610!important;padding:8px!important;overflow:hidden;min-width:280px!important;color:#efedf9}body.pro-console *{box-sizing:border-box}body.pro-console #app{height:calc(100vh - 16px);height:calc(100dvh - 16px);min-height:0!important;max-width:2100px!important;padding:0!important;display:grid;grid-template-rows:146px 44px 22px minmax(0,1fr) 26px;border-width:8px!important;background:#090c18!important;border-radius:22px;overflow:hidden;box-shadow:0 0 16px #9f82d04d!important}body.pro-console .topbar{height:auto!important;min-height:0!important;padding:10px 18px 16px!important;background:radial-gradient(ellipse at 74% 35%,#3320495e,transparent 60%),#090a15!important;isolation:isolate}body.pro-console .topbar:before{opacity:.4}body.pro-console .topbar:after{height:18px!important;background-size:100% auto!important}body.pro-console .brand{gap:14px!important;min-width:0!important;z-index:2;flex:1}body.pro-console .brandmark{width:104px!important;min-width:104px!important;height:108px!important;animation:none!important;filter:drop-shadow(0 0 9px #b7a4e950)!important}body.pro-console .logo-main{font:italic 400 clamp(32px,3.5vw,54px)/.96 Georgia,serif!important;letter-spacing:-.045em!important}body.pro-console .logo-sub{font:italic 400 clamp(23px,2.4vw,39px)/1.02 Georgia,serif!important;letter-spacing:-.025em!important;margin-top:5px!important}body.pro-console .brand-name{display:none!important}body.pro-console .brand-credit{font-size:10px!important;letter-spacing:.35em!important;margin-top:13px!important;color:#d2cfe3!important}body.pro-console .guardian-portrait{height:132px!important;width:30%!important;max-width:340px;align-self:center!important;position:relative;z-index:0;opacity:1!important}body.pro-console .guardian-portrait img{width:100%!important;height:154px!important;bottom:-8px!important;right:0!important;object-fit:cover!important;object-position:47% 32%!important;filter:contrast(1.05)!important;mask-image:linear-gradient(90deg,transparent,#000 15%,#000 84%,transparent),linear-gradient(0deg,transparent,#000 13%,#000);mask-composite:intersect;-webkit-mask-composite:source-in}body.pro-console .guardian-portrait:before{background:radial-gradient(ellipse,#5b367e60,transparent 72%)!important;inset:0!important}body.pro-console .guardian-star{font-size:25px!important;animation:none!important}body.pro-console .guardian-caption{display:none!important}body.pro-console .toolstrip{min-height:0!important;padding:5px 12px!important;background:linear-gradient(90deg,#151729,#0d1020 60%,#19152b)!important;display:flex!important;align-items:center!important;flex-wrap:nowrap!important;gap:8px!important;overflow:hidden;border-color:#8c779f88!important}body.pro-console .head-actions{width:100%;margin:0!important;flex-wrap:nowrap!important;gap:7px!important;align-items:center}body.pro-console .head-actions .localnote{display:block!important;margin-right:auto;font:8px monospace;letter-spacing:.1em;color:#9ea5c6!important}body.pro-console .btn,body.pro-console .little{font:500 11px/1.1 system-ui!important;border:1px solid #776e91!important;padding:9px 12px!important;background:linear-gradient(155deg,#34344c,#12182b 60%,#343044)!important;color:#ece9f9!important;border-radius:7px!important;box-shadow:inset 0 1px #d5c7ec64,0 2px 3px #0005!important;min-height:32px}body.pro-console .btn.primary{background:linear-gradient(140deg,#d6c2ef,#8477ac 55%,#d5d7f0)!important;color:#100e24!important;border-color:#d9c8f3!important}body.pro-console .head-actions #recordVideo{margin-left:3px}body.pro-console .system-bus{min-height:0!important;height:22px!important;padding:4px 12px!important;background:#121522!important;color:#a6a9c3!important;font:8px monospace!important;border-color:#5a536c99!important;letter-spacing:.16em!important}body.pro-console .sys-bus-mid{display:none!important}body.pro-console .workspace{position:relative;display:grid!important;grid-template-columns:225px minmax(0,1fr) 280px!important;grid-template-rows:minmax(0,1fr) 118px!important;gap:8px!important;padding:8px!important;min-height:0!important;height:auto!important;overflow:hidden;background:#090c17!important}body.pro-console .sidebar{min-height:0!important;max-height:none!important;border-width:6px!important;border-radius:12px!important;overflow:hidden!important;background:linear-gradient(135deg,#17192a,#0d1120 66%)!important;box-shadow:inset 0 0 15px #78679412!important;display:flex!important;flex-direction:column!important}body.pro-console .library{grid-column:1!important;grid-row:1/3!important}body.pro-console .inspector{grid-column:3!important;grid-row:1/3!important}body.pro-console .panelhead{padding:12px 10px 10px!important;gap:3px;align-items:center;flex-shrink:0}body.pro-console .panelhead h2{font:400 22px Georgia,serif!important;margin:4px 0 0!important;color:#ebe7f8!important;letter-spacing:0!important;text-shadow:none!important}body.pro-console .panelhead .eyebrow,body.pro-console .eyebrow{font:8px monospace!important;letter-spacing:.14em!important;color:#bdb0d7!important}body.pro-console .micro,body.pro-console .inspector-icon{display:none!important}body.pro-console .tabbar{padding:0 9px!important;gap:15px!important;min-height:36px;flex-shrink:0;background:#101321!important;border-color:#3a3c56!important}body.pro-console .tab{font:9px system-ui!important;padding:9px 0!important;letter-spacing:.09em!important;color:#a5a4bf!important}body.pro-console .tab.active{background:transparent!important;border-bottom-color:#d5b9f4!important;color:#fff!important}body.pro-console .library-section{padding:10px!important;min-height:0!important;overflow:hidden!important;flex:1;display:flex;flex-direction:column}body.pro-console .search{padding:9px 10px!important;margin:0 0 8px!important;min-height:35px;background:#090e1d!important;border-color:#514d6b!important;font:11px system-ui!important;flex-shrink:0}body.pro-console .categories{max-height:85px!important;min-height:0!important;margin:0 0 7px!important;padding:0 0 5px!important;gap:4px!important;overflow:auto;flex-shrink:0}body.pro-console .chip{padding:5px 7px!important;font:8px system-ui!important;border-color:#47465e!important;background:#15192b!important;min-height:26px;color:#bdbbd3!important;white-space:nowrap}body.pro-console .chip.active{border-color:#b79bce!important;color:#f6e8ff!important;background:#322b49!important;box-shadow:none!important}body.pro-console .section-caption{font:8px monospace!important;letter-spacing:.13em;margin:4px 0 9px!important;color:#a7a3be!important;flex-shrink:0}body.pro-console .effect-list{min-height:0;max-height:none!important;overflow:auto!important;flex:1;align-content:start!important;gap:5px!important;padding-right:3px;scrollbar-width:thin;scrollbar-color:#776b97 #101424}body.pro-console .effect-item{min-height:55px!important;gap:8px!important;padding:7px!important;border-radius:6px!important;border-color:#393e57!important;background:linear-gradient(120deg,#20233a,#101526)!important;box-shadow:none!important}body.pro-console .effect-item:hover{border-color:#b999d7!important;background:#25223e!important}body.pro-console .effect-item strong{font:500 9px/1.3 system-ui!important;letter-spacing:.055em!important;color:#eae6fa!important}body.pro-console .effect-item small{font:9px/1.3 system-ui!important;color:#9c9eb8!important;margin-top:4px!important}body.pro-console .effect-swatch{width:28px!important;height:30px!important;font-size:15px!important;border:1px solid #8a7ba4!important;filter:saturate(.6);border-radius:5px!important}body.pro-console .effect-plus{font-size:15px!important;color:#b6a4d8!important}body.pro-console .preset-list{overflow:auto;min-height:0;flex:1}body.pro-console .preset-item{min-height:80px!important;background:#14182b!important;color:#e4def7!important}body.pro-console .sidebar-foot{display:none!important}body.pro-console .center{grid-column:2!important;grid-row:1!important;min-height:0!important;background:#0c0f1d!important;display:grid!important;grid-template-rows:28px minmax(0,1fr) 42px 68px 60px!important;overflow:hidden;border-radius:12px}body.pro-console .stage-top{height:28px!important;min-height:0!important;padding:4px 10px!important;background:linear-gradient(90deg,#222037,#101626)!important;gap:5px!important;border-bottom:1px solid #6d587e88}body.pro-console .stage-label{min-width:0;gap:12px}body.pro-console .stage-name{font:9px system-ui!important;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:160px!important;color:#a9aec9!important}.pro-render-badge{font:7px monospace;letter-spacing:.09em;color:#c4badb;white-space:nowrap}body.pro-console .stage-shell{min-height:0!important;padding:7px!important;display:grid!important;place-items:center!important;overflow:hidden!important;flex:initial!important;background:radial-gradient(ellipse,#21173220,transparent),#070b16!important}body.pro-console .stage-shell:before,body.pro-console .stage-shell:after,body.pro-console .crystal-corner{display:none!important}body.pro-console .monitor-unit{width:auto!important;max-width:100%!important;min-width:0!important;min-height:0!important;max-height:100%!important;padding:2px 3px!important;border-width:7px!important;border-radius:10px!important;background:#0b101c!important;box-shadow:0 0 17px #9576c02b!important;overflow:hidden}body.pro-console .monitor-rail{font:6px monospace!important;min-height:0!important;height:12px!important;padding:0 3px 3px!important;display:flex;justify-content:space-between}body.pro-console .rail-sub,body.pro-console .monitor-bottom,body.pro-console .monitor-bolt{display:none!important}body.pro-console .stage-background{aspect-ratio:auto!important;max-width:100%!important;min-height:0!important;border:1px solid #c1acc984!important;border-radius:5px!important;box-shadow:none!important;background:#060912!important}body.pro-console .stage-background canvas{object-fit:contain;max-height:100%}body.pro-console .transport{min-height:0!important;height:42px!important;padding:3px 7px!important;border-width:0 0 1px!important;border-image:none!important;border-color:#403653!important;margin:0!important;border-radius:0!important;background:#111528!important;gap:8px!important;flex-wrap:nowrap!important;overflow:hidden}body.pro-console .transportbtn{min-width:30px;min-height:32px;font-size:17px!important;color:#e5daef!important;padding:2px!important}body.pro-console .transportbtn.play{min-width:32px!important;width:32px!important;height:32px!important;border-radius:6px!important;font-size:13px!important;background:#302a48!important}body.pro-console .transport input[type=range]{height:32px;accent-color:#c7a7e9!important;min-width:20px!important}body.pro-console .timecode{font:9px monospace!important}body.pro-console .durationlabel,body.pro-console .transport .separator,body.pro-console .transport #sourceSound{display:none!important}.